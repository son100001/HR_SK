<title>Hướng Dẫn Sử Dụng Phần Mềm Nhân Sự SmartBooks.HR</title>
<style>
    body { font-family: "Times New Roman", Times, serif; font-size: 14pt; line-height: 1.5; }
    h1 { color: #003366; text-align: center; font-size: 24pt; }
    h2 { color: #0055A4; border-bottom: 1px solid #0055A4; padding-bottom: 5px; font-size: 18pt; margin-top: 30px; }
    h3 { color: #333333; font-size: 16pt; margin-top: 20px; }
    .note { background-color: #f9f9f9; border-left: 4px solid #f0ad4e; padding: 10px; margin: 10px 0; font-style: italic; }
    .important { background-color: #ffeeba; border-left: 4px solid #d39e00; padding: 10px; margin: 10px 0; }
    .placeholder { background-color: #e9ecef; border: 2px dashed #6c757d; padding: 40px; text-align: center; color: #495057; margin: 20px 0; font-weight: bold; }
